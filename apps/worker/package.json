    "@repo/vector-store": "*",
    "bullmq": "^5.34.0",
    "ioredis": "^5.9.3",
    "turndown": "^7.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:^",
    "@types/node": "^22.15.3",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-only-warn": "^1.1.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-turbo": "^2.8.10",
    "globals": "^17.3.0",
