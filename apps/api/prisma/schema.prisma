datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Document {
  id             String    @id @default(uuid())
  title          String
  sourceType     String    @map("source_type")
  sourceUrl      String?   @map("source_url")
  rawContent     String    @map("raw_content")
  status         String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  userId         String    @default("default") @map("user_id")
  processingError String?  @map("processing_error")
  
  // New fields from FPR
  type           String    @default("OTHER") // ARTICLE, VIDEO, COURSE_LESSON, BOOK, NOTE, RFC, BLOG, TRANSCRIPT, OTHER
  author         String?
  publisher      String?
  publishedAt    DateTime? @map("published_at")
  language       String    @default("en")
  learningStatus String    @default("UPCOMING") @map("learning_status") // TO_WATCH, TO_READ, UPCOMING, IN_PROGRESS, REVIEW, COMPLETED, PENDING_COMPLETION
  addedByUserAt  DateTime  @default(now()) @map("added_by_user_at")
  
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  chunks          Chunk[]
  DocumentTag     DocumentTag[]
  annotations     Annotation[]
  ImportanceScore ImportanceScore?
  Review          Review[]
  ReviewLog       ReviewLog[]
  collectionItems CollectionItem[]
  learningGoalItems LearningGoalItem[]
  statusHistory     LearningStatusHistory[]

  @@map("documents")
}

model UserLlmConfig {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  embeddingProvider  String   @map("embedding_provider")
  embeddingModel     String   @map("embedding_model")
  generationProvider String   @map("generation_provider")
  generationModel    String   @map("generation_model")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("user_llm_configs")
}

model LearningStatusHistory {
  id             String   @id @default(uuid())
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId     String   @map("document_id")
  status         String
  learningStatus String   @map("learning_status")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("learning_status_history")
}

model Chunk {
  id          String   @id @default(uuid())
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId  String   @map("document_id")
  content     String
  startOffset Int      @map("start_offset")
  endOffset   Int      @map("end_offset")
  createdAt   DateTime @default(now()) @map("created_at")

  conceptChunks ConceptChunk[]
  annotations   Annotation[]
  reviewLogs    ReviewLog[]

  @@index([documentId])
  @@map("chunks")
}

model Tag {
  id   String @id @default(uuid())
  name String @unique

  documentTags DocumentTag[]

  @@index([name])
  @@map("tags")
}

model DocumentTag {
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String   @map("document_id")
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId      String   @map("tag_id")

  @@id([documentId, tagId])
  @@index([documentId, tagId])
  @@map("document_tags")
}

model ConceptChunk {
  chunk     Chunk   @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  chunkId   String  @map("chunk_id")
  concept   Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  conceptId String  @map("concept_id")

  @@id([chunkId, conceptId])
  @@index([chunkId, conceptId])
  @@map("concept_chunks")
}

model Annotation {
  id         String   @id @default(uuid())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String   @map("document_id")
  chunk      Chunk?   @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  chunkId    String?  @map("chunk_id")
  
  type       String   @default("NOTE") // HIGHLIGHT, NOTE, QUESTION, INSIGHT
  content    String
  selectedText String?  @map("selected_text")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("annotations")
}

model ImportanceScore {
  id         String   @id @default(uuid())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String   @unique @map("document_id")
  score      Int // 1-5

  @@map("importance_scores")
}

model Review {
  id             String   @id @default(uuid())
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId     String   @unique @map("document_id")
  
  // Spaced repetition fields
  lastReviewedAt DateTime @default(now()) @map("last_reviewed_at")
  nextReviewDate DateTime @default(now()) @map("next_review_date")
  interval       Float    @default(0) // Interval in days
  easeFactor     Float    @default(2.5) @map("ease_factor")
  repetitionCount Int     @default(0) @map("repetition_count")
  reviewScore    Int      @map("review_score") // 0-5

  @@index([documentId])
  @@map("reviews")
}

// Track historical review outcomes
model ReviewLog {
  id          String   @id @default(uuid())
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId  String   @map("document_id")
  chunk       Chunk?   @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  chunkId     String?  @map("chunk_id")
  
  feedback    String   // EASY, MEDIUM, HARD
  timestamp   DateTime @default(now())

  @@index([documentId])
  @@map("review_logs")
}

model Concept {
  id    String @id @default(uuid())
  label String @unique

  fromRelations ConceptRelation[] @relation("FromConcept")
  toRelations   ConceptRelation[] @relation("ToConcept")
  conceptChunks ConceptChunk[]

  @@index([label])
  @@map("concepts")
}

model ConceptRelation {
  id            String  @id @default(uuid())
  fromConcept   Concept @relation("FromConcept", fields: [fromConceptId], references: [id], onDelete: Cascade)
  fromConceptId String  @map("from_concept_id")
  toConcept     Concept @relation("ToConcept", fields: [toConceptId], references: [id], onDelete: Cascade)
  toConceptId   String  @map("to_concept_id")
  relationType  String  @map("relation_type")

  @@unique([fromConceptId, toConceptId, relationType])
  @@map("concept_relations")
}

model Collection {
  id          String   @id @default(uuid())
  name        String
  description String?
  goal        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items CollectionItem[]
  goals LearningGoalItem[]

  @@map("collections")
}

model CollectionItem {
  id             String     @id @default(uuid())
  collection     Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId   String     @map("collection_id")
  document       Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId     String     @map("document_id")
  
  order          Int        @default(0)
  prerequisiteId String?    @map("prerequisite_id") // ID of another document that must be completed first

  @@unique([collectionId, documentId])
  @@index([collectionId])
  @@map("collection_items")
}

model LearningGoal {
  id          String   @id @default(uuid())
  name        String
  deadline    DateTime?
  progress    Float    @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items       LearningGoalItem[]

  @@map("learning_goals")
}

model LearningGoalItem {
  id             String       @id @default(uuid())
  goal           LearningGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  goalId         String       @map("goal_id")
  
  // Can link to either a collection or directly to a single document (for flexibility, though primarily collections are used)
  collection     Collection?  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId   String?      @map("collection_id")

  document       Document?    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId     String?      @map("document_id")
  
  @@map("learning_goal_items")
}
