NODE_ENV=development

# Core services
DATABASE_URL=postgresql://postgres:password@localhost:5432/mindstack?schema=public
REDIS_URL=redis://localhost:6379
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=mind-stack

# API
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
LOG_LEVEL=debug
# Optional: when set, requests must include x-api-key
# API_KEY=change-me
# Optional: authenticated YouTube cookie for caption fetches in bot-gated environments
# YOUTUBE_COOKIE=VISITOR_INFO1_LIVE=...; LOGIN_INFO=...; SID=...
# Optional: proxy URL used only for YouTube fetches (example: http://user:pass@host:port)
# YOUTUBE_PROXY_URL=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=all-minilm
OLLAMA_MODEL=tinyllama

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
